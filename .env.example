# Copy this file to .env and fill in the values below.
# Every setting the demo needs from you lives in this one file.

# ── LLM provider ──────────────────────────────────────────────────
# litellm-style "<provider>/<model>" string. Change this one value to
# swap vendors -- no code changes needed anywhere else in the repo.
# openrouter/openrouter/free routes each call to a random free model on
# OpenRouter that supports tool calling -- no cost, but less predictable
# than a single pinned model. anthropic/claude-haiku-4-5-20251001 is the
# most-verified fallback if reliability ever matters more than cost.
LLM_MODEL=openrouter/openrouter/free
# LLM_MODEL=anthropic/claude-haiku-4-5-20251001

# Set whichever API key matches the provider in LLM_MODEL above.
# litellm reads these automatically by provider convention.
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Cluster targeting ────────────────────────────────────────────────
# kubectl context to use. Leave blank to use your current context.
KUBE_CONTEXT=

# Prefix for every namespace/resource this repo creates and later
# deletes on teardown. Only change this if "pod-investigator-*" collides
# with something already on your cluster.
NAMESPACE_PREFIX=pod-investigator

# Local ports used for `kubectl port-forward` to Grafana / Jaeger / the
# OTel Collector's OTLP/gRPC receiver. Bound to 0.0.0.0 so they're reachable
# from other devices on your Tailscale net, not just localhost on the
# cluster host.
GRAFANA_LOCAL_PORT=3000
JAEGER_LOCAL_PORT=16686
OTEL_LOCAL_PORT=4317

# Simulated SPIFFE identity attached to every agent action.
SPIFFE_ID=spiffe://homelab/deploy-bot
SPIFFE_SCOPE=staging

# Where mcp_server/otel_setup.py exports spans. Defaults to the
# OTLP port-forward started by scripts/lib/start_port_forward.sh above.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
